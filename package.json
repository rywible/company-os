{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BUN_DEV=1 bun --watch src/server/index.ts",
    "build": "bun scripts/build.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:ui": "bun run build && bun test ./e2e/mobile.test.ts",
    "postinstall": "bun scripts/prepare-dependencies.ts",
    "verify:backup": "bun scripts/verify-backup.ts"
  },
  "dependencies": {
    "@fly/sprites": "0.2.3",
    "lucide-react": "1.47.0",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sqlite-vec": "0.1.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
