PORT=3000
DATABASE_PATH=./data/company.sqlite
# On macOS, install sqlite via Homebrew to enable loadable extensions.
# SQLITE_LIBRARY=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib
# name=provider entries. Use | when one authenticated worker supports more than one provider.
SPRITE_POOL=company-os-studio-01=openai,company-os-studio-02=openai,company-os-studio-03=openai,company-os-studio-04=anthropic,company-os-studio-05=anthropic,company-os-studio-06=anthropic,company-os-studio-07=meta,company-os-studio-08=meta,company-os-studio-09=meta,company-os-studio-10=meta
# Legacy single-worker fallback when SPRITE_POOL is empty.
SPRITE_NAME=company-os-worker
WORKER_CONCURRENCY=10
SPRITES_TOKEN=
GEMINI_CONNECTOR_ID=
GITHUB_CONNECTOR_ID=
ANTHROPIC_CONNECTOR_ID=
META_CONNECTOR_ID=
GITHUB_REPOSITORY=rywible/company-os
EMBEDDING_MODEL=gemini-embedding-001
# Required in production. Keep this out of git.
ADMIN_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=
